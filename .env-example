
#------------------------------------------
# BACKEND-OMNIBUS
#------------------------------------------
LISTEN_ADDR=:4989

JWT_SECRET=change-me
PASSWORD_RESET_JWT_SECRET=change-me-too

#------------------------------------------
# DATABASE CONFIG
#------------------------------------------
DB_URL=host=localhost 
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=omnibus-terminal
DB_PORT=5432 
DB_SSLMODE=disable

#------------------------------------------
# FRONTEND
#------------------------------------------
FRONT_END_BASE_LINK=http://localhost:4200/
MAIL_SITE_NAME="Ya llegó"
# Public URL of the isotype shown in emails (must be reachable from the internet, not localhost)
MAIL_LOGO_URL=https://raw.githubusercontent.com/Gonzze-dev/omnibus-backend/main/internal/mail/isotype.png

#------------------------------------------
# CORS (comma-separated origins; empty = all)
#------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

#------------------------------------------
# BACKEND TERMINAL
#------------------------------------------
EXTERN_TERMINAL_UPSTREAM_URL=http://localhost:4990

#------------------------------------------
# MICROSERVICES REALTIME
#------------------------------------------
REALTIME_URL=http://localhost:4988/realtime
REALTIME_API_KEY=your-realtime-api-key

#------------------------------------------
# CAMERA NOTIFICATIONS API KEY
#------------------------------------------
CAMERA_NOTIFICATION_API_KEY=your-camera-api-key

#------------------------------------------
# MICROSERVICES OCR
#------------------------------------------
OCR_URL=http://localhost:8000
OCR_API_KEY=your-ocr-api-key

#------------------------------------------
# MAIL
#------------------------------------------
# Sender address, used by both Brevo and SMTP. Accepts "Name <email>".
SMTP_FROM="Ya llegó <your-email@example.com>"

# Brevo HTTP API. When set, it takes precedence over SMTP
# (use it on hosts that block outbound SMTP, e.g. Railway Hobby).
# The SMTP_FROM address must be a verified sender in Brevo.
BREVO_API_KEY=

# SMTP (used when BREVO_API_KEY is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
