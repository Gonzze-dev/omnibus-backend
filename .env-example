# Servidor HTTP
LISTEN_ADDR=:4989

# Base de datos (DSN de PostgreSQL)
DB_URL=host=localhost 
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=omnibus-terminal
DB_PORT=5432 
DB_SSLMODE=disable

# JWT
JWT_SECRET=change-me
PASSWORD_RESET_JWT_SECRET=change-me-too

# Frontend (link usado en los mails de reseteo de contraseña)
FRONT_END_BASE_LINK=http://localhost:4200/
MAIL_SITE_NAME=Omnibus

# Backend de terminales
EXTERN_TERMINAL_UPSTREAM_URL=http://localhost:4990

# Microservicio RealTime (SignalR)
REALTIME_URL=http://localhost:4988/realtime
REALTIME_API_KEY=your-realtime-api-key

# API key que debe enviar la cámara al notificar llegadas
CAMERA_NOTIFICATION_API_KEY=your-camera-api-key

# Microservicio OCR
OCR_URL=http://localhost:8000
OCR_API_KEY=your-ocr-api-key

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-email@example.com
